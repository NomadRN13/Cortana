{
  "$schema": "RSVPlay brand tokens. Generated by scripts/build-tokens.js from mobile/src/theme.js; do not edit by hand.",
  "color": {
    "ink": {
      "value": "#14161C",
      "use": "Ground on dark surfaces; text on light surfaces"
    },
    "court": {
      "value": "#F5F4EE",
      "use": "Light ground; text on dark surfaces"
    },
    "optic": {
      "value": "#C8F04A",
      "use": "The one accent: primary actions, active states"
    },
    "courtBlue": {
      "value": "#2F5BFF",
      "use": "Secondary accent: event headers, avatars"
    },
    "surface": {
      "value": "#1E2128",
      "use": "Cards on Ink"
    },
    "surface2": {
      "value": "#272B33",
      "use": "Chips and date boxes inside cards"
    },
    "panel": {
      "value": "#1A1D24",
      "use": "Tab bars and sheets"
    },
    "line": {
      "value": "#2E323B",
      "use": "Card borders (solid equivalent of the app's 13% Court line)"
    },
    "lineStrong": {
      "value": "#3E434E",
      "use": "Inputs and outlined buttons"
    },
    "muted": {
      "value": "#C9CBD2",
      "use": "Secondary text on dark (solid equivalent of 62% Court)"
    },
    "success": {
      "value": "#3DC96B",
      "use": "Verified badges, confirmations"
    },
    "danger": {
      "value": "#E15A72",
      "use": "Destructive and negative actions only"
    }
  },
  "alpha": {
    "line": "rgba(245,244,238,0.13)",
    "dim": "rgba(245,244,238,0.62)",
    "opticDim": "rgba(200,240,74,0.16)"
  },
  "font": {
    "headline": {
      "family": "Space Grotesk",
      "weight": 700,
      "tracking": "-0.02em"
    },
    "body": {
      "family": "Inter",
      "weights": [
        400,
        500,
        600,
        700
      ]
    }
  },
  "radius": {
    "card": 16,
    "cardLarge": 20,
    "pill": 22,
    "button": 27
  },
  "app": {
    "night": "#14161C",
    "panel": "#1A1D24",
    "card": "#1E2128",
    "card2": "#272B33",
    "line": "rgba(245,244,238,0.13)",
    "text": "#F5F4EE",
    "dim": "rgba(245,244,238,0.62)",
    "optic": "#C8F04A",
    "opticDim": "rgba(200,240,74,0.16)",
    "ok": "#3DC96B",
    "ink": "#14161C",
    "danger": "#E15A72"
  }
}
