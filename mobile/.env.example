# Copy to .env and fill in from your Supabase project's Settings → API.
# Until these are set, the app runs in demo mode with seeded local data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Sign in with Google (optional) ---------------------------------------
# Leave these blank and the "Continue with Google" button simply doesn't
# appear — email codes and Sign in with Apple keep working. Fill them in from
# Google Cloud → APIs & Services → Credentials once you've created the OAuth
# clients (walkthrough in docs/backend-setup.md).
#
# WEB client ID: this is the audience of the token on Android. Required.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID: required only for Google sign-in on iPhone.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
