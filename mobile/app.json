{
  "expo": {
    "name": "40/Love",
    "slug": "fortylove",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fortylove",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0D"
    },
    "ios": {
      "bundleIdentifier": "com.fortylove.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "40/Love uses your photo library so you can add profile photos.",
        "NSCameraUsageDescription": "40/Love uses your camera so you can take a profile photo."
      }
    },
    "android": {
      "package": "com.fortylove.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B0D"
      },
      "permissions": ["android.permission.READ_MEDIA_IMAGES", "android.permission.CAMERA"]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "40/Love uses your photo library so you can add profile photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_AFTER_RUNNING_eas_init"
      }
    }
  }
}
